# SCIP interoperability fixture (#1100). Stored as Cargo.toml.fixture so
# `cargo package` keeps this directory; scripts/scip/regenerate.sh copies it
# to Cargo.toml in a disposable directory before indexing.
[package]
name = "scip_ambiguous"
version = "0.1.0"
edition = "2021"
publish = false

[lib]
path = "src/lib.rs"

[workspace]
