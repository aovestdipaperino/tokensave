#[allow(dead_code)]
#[path = "REPOS_PATH"]
mod repos;
use std::path::PathBuf;
use std::time::Instant;
fn main() {
    let dir = PathBuf::from(std::env::args_os().nth(1).unwrap());
    let start = Instant::now();
    {
        #[cfg(after)]
        let _owned = repos::ScratchDir::create(&dir, ".tokensave-bench-scratch").unwrap();
        #[cfg(before)]
        std::fs::create_dir(dir.join(".tokensave-bench-scratch")).unwrap();
        std::fs::write(dir.join(".tokensave-bench-scratch").join("query.txt"), vec![b'x'; 1 << 20]).unwrap();
        #[cfg(before)]
        {
            std::fs::remove_dir_all(dir.join(".tokensave-bench-scratch")).unwrap();
            repos::restore_repo(&dir).unwrap();
        }
    }
    println!("{}", start.elapsed().as_secs_f64() * 1000.0);
}
